# ============================================================
# CampusFlow API - variáveis de ambiente
# ============================================================

NODE_ENV=development
PORT=3333
LOG_LEVEL=debug

# URL do frontend permitida no CORS (separar múltiplas por vírgula)
CORS_ORIGINS=http://localhost:5173

# Supabase (usar SERVICE ROLE apenas no servidor; nunca expor ao frontend)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# URLs públicas (QR Code de check-in, links de e-mail)
WEB_BASE_URL=http://localhost:5173
API_BASE_URL=http://localhost:3333

# WhatsApp Cloud API (Meta for Developers)
WHATSAPP_API_VERSION=v20.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=campusflow-webhook

# SendGrid
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=nao-responda@campusflow.app
SENDGRID_FROM_NAME=CampusFlow
SENDGRID_WEBHOOK_PUBLIC_KEY=

# Worker de filas (pgmq)
QUEUE_POLL_INTERVAL_MS=5000
QUEUE_VISIBILITY_TIMEOUT_S=60
QUEUE_MAX_RETRIES=5

# Mapbox (uso opcional no servidor, ex.: geocodificação)
MAPBOX_ACCESS_TOKEN=
