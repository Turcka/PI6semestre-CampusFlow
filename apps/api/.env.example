# ============================================================
# CampusFlow API - variáveis de ambiente
# ============================================================

NODE_ENV=development
PORT=3333
LOG_LEVEL=debug

# Em development, CPF aceita 11 dígitos sem checksum. Em production use true só para testes.
# RELAX_CPF_VALIDATION=true

# Em production, permite lookup do portal por e-mail (só para testes controlados).
# ALLOW_PORTAL_EMAIL_LOOKUP=true

# URL do frontend permitida no CORS (separar múltiplas por vírgula)
CORS_ORIGINS=http://localhost:5173

# Supabase (usar SERVICE ROLE apenas no servidor; nunca expor ao frontend)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# URLs públicas (QR Code de check-in, links de e-mail)
WEB_BASE_URL=http://localhost:5173
API_BASE_URL=http://localhost:3333

# WhatsApp Cloud API (Meta for Developers)
WHATSAPP_API_VERSION=v20.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=campusflow-webhook

# SendGrid
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=nao-responda@campusflow.app
SENDGRID_FROM_NAME=CampusFlow
SENDGRID_WEBHOOK_PUBLIC_KEY=

# Worker de filas (pgmq)
QUEUE_POLL_INTERVAL_MS=5000
QUEUE_VISIBILITY_TIMEOUT_S=60
QUEUE_MAX_RETRIES=5

# Mapbox (uso opcional no servidor, ex.: geocodificação)
MAPBOX_ACCESS_TOKEN=

# Secretário virtual (LLM) - ver src/integrations/llm/README.md
# Só liga com LLM_ENABLED=true E LLM_API_KEY preenchida; além disso o admin precisa ligar o
# assistente em Configurações > Assistente virtual. Desligado, o chatbot segue por botões.
LLM_ENABLED=false
# openai | anthropic | gemini | openai_compatible
LLM_PROVIDER=openai
LLM_API_KEY=
# Obrigatório para openai_compatible (ex.: http://localhost:11434/v1); opcional nos demais (proxy).
LLM_BASE_URL=
# Ajuste ao provedor escolhido.
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_MS=12000
LLM_MAX_TURNS=16
LLM_MAX_OUTPUT_TOKENS=400
LLM_SESSION_TOKEN_BUDGET=40000
