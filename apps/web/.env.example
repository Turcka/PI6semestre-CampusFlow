# ============================================================
# CampusFlow Web (PWA) - variáveis de ambiente
# Somente variáveis com prefixo VITE_ são expostas ao browser.
# NUNCA colocar service role key aqui.
# ============================================================

VITE_API_URL=http://localhost:3333
VITE_API_PROXY_TARGET=http://localhost:3333

# Supabase (chave anon é pública por design; segurança vem do RLS)
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=

# Mapbox (token público restrito por domínio)
VITE_MAPBOX_ACCESS_TOKEN=
VITE_MAPBOX_STYLE=mapbox/streets-v12
