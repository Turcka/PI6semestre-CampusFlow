# ============================================================
# CampusFlow - variáveis de ambiente (raiz)
# Copie para .env e preencha. Cada app também possui seu próprio
# .env.example em apps/api e apps/web.
# ============================================================

# Supabase (projeto local: `supabase start` mostra estes valores)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# API
API_PORT=3333
API_BASE_URL=http://localhost:3333

# Frontend
WEB_BASE_URL=http://localhost:5173

# WhatsApp Cloud API (Meta)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=

# SendGrid
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=nao-responda@campusflow.app
SENDGRID_FROM_NAME=CampusFlow

# Mapbox
MAPBOX_ACCESS_TOKEN=
